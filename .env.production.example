# Copie para .env.production, restrinja com chmod 600 e preencha fora do Git.
NODE_ENV=production
PORT=3000
APP_PORT=3000
APP_IMAGE=almoxarifado-cmsp:production
PRODUCTION_DOMAIN=sapgestao.dpdns.org
TMPFS_SIZE=256m

# Neon: prefira a URL pooled para runtime e a URL direta para migracoes/backup.
# Substitua somente os marcadores; nunca versione as URLs reais.
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@YOUR_NEON_POOLED_HOST/neondb?sslmode=require&channel_binding=require
DATABASE_URL_MIGRATION=postgresql://MIGRATION_USER:URL_ENCODED_PASSWORD@YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channel_binding=require
# Banco separado e descartavel. O nome deve conter "test" e nunca pode ser o banco de producao.
# TEST_DATABASE_URL=postgresql://TEST_USER:URL_ENCODED_PASSWORD@YOUR_NEON_TEST_HOST/neondb_test?sslmode=require&channel_binding=require
DB_SSL=true
DB_CA_CERT_PATH=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=1000

# Autenticacao e administracao. Use valores reais somente em .env.production.
ADMIN_EMAILS=YOUR_ADMIN_EMAIL
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# Deixe false em instalacoes novas. Use true somente depois de confirmar no
# PostgreSQL que ja existe administrador ativo com senha local valida.
CONFIRM_EXISTING_ADMIN_PROVISIONED=false

# SMTP transacional (alternativamente use GMAIL_USER/GMAIL_APP_PASSWORD).
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM_ADDRESS=noreply@sapgestao.dpdns.org
EMAIL_FROM_NAME=Almoxarifado CMSP
EMAIL_TEST_RECIPIENT=YOUR_TEST_RECIPIENT

SESSION_TIMEOUT_MS=1800000
SESSION_COOKIE_MAX_AGE_MS=604800000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
AUTH_MAX_BODY_BYTES=4096
ADMIN_MAX_BODY_BYTES=65536
LOGIN_SCRYPT_CONCURRENCY=4
LOGIN_SCRYPT_MAX_QUEUE=16
TRUST_PROXY=true
MAX_JSON_BODY_BYTES=25165824
MAX_UPLOAD_BYTES=15728640
MAX_PROCESS_UPLOAD_BYTES=78643200
MAX_TEMPLATE_UPLOAD_BYTES=52428800
MAX_PROCESS_DOCUMENTS=50
MAX_TEMPLATE_ATTACHMENTS=20
MAX_COMPILED_DOWNLOAD_BYTES=78643200
MAX_COMPILED_DOWNLOADS=2
PDF_COMMAND_TIMEOUT_MS=10000
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_COMMAND_TIMEOUT_MS=15000
EMAIL_DISPATCH_LEASE_MS=600000
EMAIL_CHECK_INTERVAL_MS=3600000
APP_TIME_ZONE=America/Sao_Paulo
DASHBOARD_CACHE_TTL_MS=5000
# Use drive no Render. O compose local preserva local como padrao.
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_ROOT=/data/uploads
UPLOAD_INTEGRITY_CACHE_TTL_MS=60000
# Obrigatorias somente com UPLOAD_STORAGE_BACKEND=drive; preencha no cofre do provedor.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Backup: o deploy descobre o volume montado e pausa a aplicacao. Para execucao
# fora do deploy, informe um diretorio local ou o nome exato do volume Docker.
BACKUP_DIR=backups
BACKUP_UPLOAD_SOURCE=
BACKUP_UPLOAD_DOCKER_VOLUME=
BACKUP_COMMAND_TIMEOUT_MS=900000
BACKUP_RETENTION_COUNT=10
BACKUP_RETENTION_DAYS=30
