# Desenvolvimento local. Para producao/Neon, use .env.production.example.
ADMIN_EMAILS=admin@example.com
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=troque-esta-senha

# Banco PostgreSQL usado na migracao do armazenamento em JSON.
DATABASE_URL=postgres://almoxarifado:almoxarifado@localhost:5432/almoxarifado_cmsp
DATABASE_URL_MIGRATION=
DB_SSL=false
DB_CA_CERT_PATH=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Envio real de e-mails via Gmail SMTP.
# Use uma senha de app do Google, nao a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app
EMAIL_FROM_ADDRESS=seu-email@gmail.com
EMAIL_FROM_NAME=Almoxarifado CMSP
EMAIL_TEST_RECIPIENT=seu-email-de-teste@example.com

# Limites operacionais e de seguranca.
SESSION_TIMEOUT_MS=1800000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
# Ative somente quando a aplicacao estiver atras de proxy confiavel que sobrescreve X-Forwarded-For.
TRUST_PROXY=false
MAX_JSON_BODY_BYTES=25165824
MAX_UPLOAD_BYTES=15728640
EMAIL_CHECK_INTERVAL_MS=3600000
UPLOAD_STORAGE_ROOT=/data/uploads
