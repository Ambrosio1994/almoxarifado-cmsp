# Desenvolvimento local. Para producao/Neon, use .env.production.example.
ADMIN_EMAILS=admin@example.com
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=Troque-esta-senha-1!
CONFIRM_EXISTING_ADMIN_PROVISIONED=false

# Banco PostgreSQL usado na migracao do armazenamento em JSON.
DATABASE_URL=postgres://almoxarifado:almoxarifado@localhost:5432/almoxarifado
DATABASE_URL_MIGRATION=
TEST_DATABASE_URL=postgres://almoxarifado:almoxarifado@localhost:5432/almoxarifado_test
DB_SSL=false
DB_CA_CERT_PATH=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=1000

# Envio real de e-mails via Gmail SMTP.
# Use uma senha de app do Google, nao a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app
EMAIL_FROM_ADDRESS=seu-email@gmail.com
EMAIL_FROM_NAME=Almoxarifado
EMAIL_TEST_RECIPIENT=seu-email-de-teste@example.com

# Limites operacionais e de seguranca.
SESSION_TIMEOUT_MS=1800000
SESSION_COOKIE_MAX_AGE_MS=604800000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
AUTH_MAX_BODY_BYTES=4096
ADMIN_MAX_BODY_BYTES=65536
LOGIN_SCRYPT_CONCURRENCY=4
LOGIN_SCRYPT_MAX_QUEUE=16
# Ative somente quando a aplicacao estiver atras de proxy confiavel que sobrescreve X-Forwarded-For.
TRUST_PROXY=false
MAX_JSON_BODY_BYTES=25165824
MAX_UPLOAD_BYTES=15728640
MAX_PROCESS_UPLOAD_BYTES=78643200
MAX_TEMPLATE_UPLOAD_BYTES=52428800
MAX_PROCESS_DOCUMENTS=50
MAX_TEMPLATE_ATTACHMENTS=20
MAX_COMPILED_DOWNLOAD_BYTES=78643200
MAX_COMPILED_DOWNLOADS=2
PDF_COMMAND_TIMEOUT_MS=10000
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_COMMAND_TIMEOUT_MS=15000
EMAIL_DISPATCH_LEASE_MS=600000
EMAIL_CHECK_INTERVAL_MS=3600000
APP_TIME_ZONE=America/Sao_Paulo
DASHBOARD_CACHE_TTL_MS=5000
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_ROOT=./uploads
UPLOAD_INTEGRITY_CACHE_TTL_MS=60000
# Obrigatorias somente com UPLOAD_STORAGE_BACKEND=drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# UPLOAD_STORAGE_ALLOW_IDENTITY_MIGRATION=true
